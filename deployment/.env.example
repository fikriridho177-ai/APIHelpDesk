# MyHelpDesk is checked out as a Git submodule under the Backend repository.
# Override this only when using a different local frontend checkout.
MYHELPDESK_CONTEXT=../MyHelpDesk
WEB_PORT=8080

# Vite values are embedded into the frontend image at build time.
VITE_API_URL=/api
VITE_IOT_API_URL=/api
# Nginx reverse-proxy target for the integrated Compose stack. In Dokploy's
# split Applications, set this to the public Backend hostname and keep the
# VITE_* values pointed at that same Backend URL.
BACKEND_UPSTREAM=api:8080

# ASP.NET Core runtime configuration.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=*

# Browser origins allowed to use SignalR from the deployed frontend.
# Replace this with the real HTTPS domain when one is configured.
Cors__Origins__0=http://helpdesk-36-88-241-11.sslip.io

# HelpDesk PostgreSQL database.
ConnectionStrings__DefaultConnection=Host=postgres.example.internal;Port=5432;Database=helpdesk;Username=helpdesk_app;Password=change-me

# Read-only SQL Server databases.
ConnectionStrings__PKBPayrollConnection=Server=sqlserver.example.internal;Database=PKBPayroll;User Id=helpdesk_app;Password=change-me;Encrypt=False;TrustServerCertificate=True
ConnectionStrings__MyPADConnection=Server=sqlserver.example.internal;Database=MyPAD;User Id=helpdesk_app;Password=change-me;Encrypt=False;TrustServerCertificate=True
ConnectionStrings__RSUPPKBConnection=Server=sqlserver.example.internal;Database=RSUPPKB;User Id=helpdesk_app;Password=change-me;Encrypt=False;TrustServerCertificate=True
ConnectionStrings__MyKTTATestConnection=Server=sqlserver.example.internal;Database=MyKTTATest;User Id=helpdesk_app;Password=change-me;Encrypt=False;TrustServerCertificate=True

# Optional read-only WebGIS database and raster storage.
ConnectionStrings__WebGis=
WebGis__StorageRoot=

# JWT authentication.
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=AuthUtility.Api
Jwt__Audience=AuthUtility.Frontend

# Optional first-admin bootstrap. Leave unset when an administrator already exists.
# The API creates no default administrator when BootstrapAdmin__Password is absent.
# BootstrapAdmin__UserId=admin
# BootstrapAdmin__Name=Administrator
# BootstrapAdmin__Email=admin@example.com
# BootstrapAdmin__Password=

# ECS integration.
Ecs__BaseUrl=https://ecs.example.internal
Ecs__UserId=replace-me

# Optional weather provider overrides.
Weather__OpenMeteoBaseUrl=https://api.open-meteo.com
Weather__BmkgAlertUrl=https://www.bmkg.go.id/alerts/nowcast/id
Weather__CacheMinutes=15
Weather__TimeoutSeconds=12
