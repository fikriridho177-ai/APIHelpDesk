# Checkout layout: keep APIHelpDesk and MyHelpDesk as sibling directories.
MYHELPDESK_CONTEXT=../../MyHelpDesk
WEB_PORT=8080

# Vite values are embedded into the frontend image at build time.
VITE_API_URL=/api
VITE_IOT_API_URL=/api

# ASP.NET Core runtime configuration.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=*

# HelpDesk PostgreSQL database.
ConnectionStrings__DefaultConnection=Host=postgres.example.internal;Port=5432;Database=helpdesk;Username=helpdesk_app;Password=change-me

# Read-only SQL Server databases.
ConnectionStrings__PKBPayrollConnection=Server=sqlserver.example.internal;Database=PKBPayroll;User Id=helpdesk_app;Password=change-me;TrustServerCertificate=True
ConnectionStrings__MyPADConnection=Server=sqlserver.example.internal;Database=MyPAD;User Id=helpdesk_app;Password=change-me;TrustServerCertificate=True
ConnectionStrings__RSUPPKBConnection=Server=sqlserver.example.internal;Database=RSUPPKB;User Id=helpdesk_app;Password=change-me;TrustServerCertificate=True
ConnectionStrings__MyKTTATestConnection=Server=sqlserver.example.internal;Database=MyKTTATest;User Id=helpdesk_app;Password=change-me;TrustServerCertificate=True

# Optional read-only WebGIS database and raster storage.
ConnectionStrings__WebGis=
WebGis__StorageRoot=

# JWT authentication.
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=AuthUtility.Api
Jwt__Audience=MyHelpDesk

# ECS integration.
Ecs__BaseUrl=https://ecs.example.internal
Ecs__UserId=replace-me

# Optional weather provider overrides.
Weather__OpenMeteoBaseUrl=https://api.open-meteo.com
Weather__BmkgAlertUrl=https://www.bmkg.go.id/alerts/nowcast/id
Weather__CacheMinutes=15
Weather__TimeoutSeconds=12
